{
  "name": "loft",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Loft: a free workspace for small teams who run things live.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w @loft/web",
    "dev:landing": "npm run dev -w @loft/landing",
    "tokens": "node packages/ui/scripts/tokens.mjs",
    "tokens:check": "node packages/ui/scripts/tokens.mjs --check",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run tokens:check && npm run typecheck && npm run lint && npm run test",
    "build": "npm run build -w @loft/landing && npm run build -w @loft/web",
    "build:pages": "node scripts/build-pages.mjs",
    "serve:site": "node scripts/serve-site.mjs",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.8",
    "vitest": "^5.1.1"
  }
}
